{
  "name": "@openclaw/macropad",
  "version": "2026.9.2",
  "private": true,
  "description": "Bind OpenClaw sessions to macropad keys with live status lighting",
  "type": "module",
  "dependencies": {
    "koffi": "3.1.6",
    "typebox": "1.3.18"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "controlUi": "./browser/index.ts",
    "assetScripts": {
      "build": "node --import ../../scripts/tsx.mjs ../../scripts/build-plugin-control-ui.mts",
      "copy": "node --import ../../scripts/tsx.mjs ../../scripts/build-plugin-control-ui.mts --copy",
      "buildOutputs": [
        "openclaw.plugin.json"
      ]
    }
  }
}
